{
  "entities": {
    "Donor": {
      "title": "Donor",
      "description": "A registered blood donor profile in the public community registry.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the donor",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Full name of the donor",
          "minLength": 1,
          "maxLength": 120
        },
        "gender": {
          "type": "string",
          "description": "Biological gender for donation eligibility",
          "enum": ["Male", "Female"]
        },
        "dob": {
          "type": "string",
          "description": "Date of birth in YYYY-MM-DD format",
          "minLength": 0,
          "maxLength": 32
        },
        "weight": {
          "type": "number",
          "description": "Weight of the donor in kilograms"
        },
        "bloodGroup": {
          "type": "string",
          "description": "ABO and Rh blood group",
          "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"]
        },
        "division": {
          "type": "string",
          "description": "Administrative division",
          "minLength": 1,
          "maxLength": 64
        },
        "district": {
          "type": "string",
          "description": "Administrative district",
          "minLength": 1,
          "maxLength": 64
        },
        "upazila": {
          "type": "string",
          "description": "Administrative upazila or thana",
          "minLength": 1,
          "maxLength": 64
        },
        "phone": {
          "type": "string",
          "description": "Verified contact phone number used as primary key",
          "minLength": 6,
          "maxLength": 20,
          "pattern": "^[0-9+\\-]+$"
        },
        "lastDonationDate": {
          "type": "string",
          "description": "Last blood donation date in YYYY-MM-DD format or empty string",
          "minLength": 0,
          "maxLength": 32
        },
        "timesDonated": {
          "type": "number",
          "description": "Total number of times the donor has donated blood"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the donor profile is active in search results"
        }
      },
      "required": [
        "id",
        "name",
        "gender",
        "dob",
        "weight",
        "bloodGroup",
        "division",
        "district",
        "upazila",
        "phone",
        "lastDonationDate",
        "timesDonated",
        "isActive"
      ]
    }
  },
  "firestore": {
    "/donors/{donorId}": {
      "schema": {
        "$ref": "#/entities/Donor"
      },
      "description": "Publicly searchable collection of registered blood donors keyed by phone number."
    }
  }
}
