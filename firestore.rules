rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDonor(data) {
      return data.keys().hasAll([
        'id', 'name', 'gender', 'dob', 'weight', 'bloodGroup',
        'division', 'district', 'upazila', 'phone', 'lastDonationDate',
        'timesDonated', 'isActive'
      ]) &&
      data.keys().hasOnly([
        'id', 'name', 'gender', 'dob', 'weight', 'bloodGroup',
        'division', 'district', 'upazila', 'phone', 'lastDonationDate',
        'timesDonated', 'isActive'
      ]) &&
      data.id is string && data.id.size() >= 1 && data.id.size() <= 64 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
      data.gender is string && data.gender.size() <= 16 && data.gender in ['Male', 'Female'] &&
      data.dob is string && data.dob.size() <= 32 &&
      data.weight is number && data.weight >= 0 && data.weight <= 300 &&
      data.bloodGroup is string && data.bloodGroup.size() <= 8 && data.bloodGroup in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'] &&
      data.division is string && data.division.size() >= 1 && data.division.size() <= 64 &&
      data.district is string && data.district.size() >= 1 && data.district.size() <= 64 &&
      data.upazila is string && data.upazila.size() >= 1 && data.upazila.size() <= 64 &&
      data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 20 && data.phone.matches('^[0-9+\\-]+$') &&
      data.lastDonationDate is string && data.lastDonationDate.size() <= 32 &&
      data.timesDonated is number && data.timesDonated >= 0 && data.timesDonated <= 500 &&
      data.isActive is bool;
    }

    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, create, update, delete: if false;
    }

    match /donors/{donorId} {
      allow get: if isValidId(donorId);
      allow list: if existing().isActive == true;
      allow create: if isValidId(donorId) && isValidDonor(incoming()) && incoming().phone == donorId;
      allow update: if (
        isValidId(donorId) &&
        isValidDonor(incoming()) &&
        incoming().phone == existing().phone &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'gender', 'dob', 'weight', 'bloodGroup',
          'division', 'district', 'upazila', 'lastDonationDate',
          'timesDonated', 'isActive'
        ])
      );
      allow delete: if isValidId(donorId);
    }

    // Phones locked out of OTP for 24 hours after 3 wrong codes.
    // Anyone can read a lock; a lock can only be created, or replaced once it has expired.
    function validLock(data) {
      return data.keys().hasOnly(['phone', 'lockedUntil']) &&
        data.phone is string && data.phone.matches('^[0-9]{11,13}$') &&
        data.lockedUntil is number &&
        data.lockedUntil > request.time.toMillis() &&
        data.lockedUntil <= request.time.toMillis() + 90000000;
    }

    match /otp_locks/{phoneId} {
      allow get: if isValidId(phoneId);
      allow list, delete: if false;
      allow create: if isValidId(phoneId) && validLock(incoming()) && incoming().phone == phoneId;
      allow update: if isValidId(phoneId) && validLock(incoming()) && incoming().phone == phoneId
        && existing().lockedUntil <= request.time.toMillis();
    }
  }
}
